{
  "name": "NOCTURNA",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "NocturnaModels": {
        "$path": "assets/models/rbxm",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": "src/client"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 0,
        "Brightness": 1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.35,
        "ExposureCompensation": 0.3,
        "EnvironmentDiffuseScale": 0.3,
        "EnvironmentSpecularScale": 0.5,
        "Ambient": [0.13, 0.13, 0.15],
        "OutdoorAmbient": [0.13, 0.13, 0.15]
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}
